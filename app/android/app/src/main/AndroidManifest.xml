<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- LOS PERMISOS DE RED VAN AQUI, Y AQUI ES LO IMPORTANTE.

         Flutter crea el proyecto con `INTERNET` declarado SOLO en
         `src/debug/AndroidManifest.xml` y `src/profile/`, porque lo que necesita
         red en esos dos modos es la recarga en caliente, no la aplicacion. El de
         `main` —el unico que entra en una compilacion de release— se queda
         sin el.

         El 16/09/2026 se instalo la release en un Galaxy A16 con wifi de cinco
         rayas y no se podia entrar: la pantalla decia «Sin conexión con el
         servidor. Comprueba la señal». Era verdad que no habia conexion, pero no
         por la señal: la aplicacion no tenia permiso para abrir un socket. Con
         los tres modos se prueba en debug —donde el permiso SI esta— eso no se
         ve nunca, y la APK de las diez tabletas habria salido muerta.

         Es el fallo tipico de esta casa: se degrada a un estado que puede ser
         verdad —«aqui no hay cobertura»— y por eso nadie lo pone en duda.

         `ACCESS_NETWORK_STATE` va con el: la franja de estado y el sincronizador
         preguntan si hay red antes de intentar subir nada. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- INSTALAR LA ACTUALIZACION SIN SALIR DE LA APLICACION — 05/10/2026.

         Jose: «el mapa si me funciona dentro de la aplicacion, pero la APK me manda
         a descargarla al navegador en vez de actualizar ahi mismo en la aplicacion
         sin necesidad de salir». La descarga ya la hace la aplicacion (reanudable y
         comprobada por sha256, el mismo motor que el mapa de Cuba); esto es lo que
         le deja pedirle a Android que instale el fichero que acaba de comprobar.

         SON DOS PERMISOS Y SOLO UNO ESTA AQUI. Este se concede al instalar la APK y
         no se le pide a nadie. El otro —«permitir instalar aplicaciones
         desconocidas» para ESTA aplicacion, de Android 8 en adelante— lo da la
         persona en los ajustes, y la primera vez NO esta dado en ningun telefono:
         por eso la aplicacion lo pregunta antes de ofrecer el boton y, si falta,
         ofrece el ajuste Y el navegador (`InstaladorDeApk.kt`).

         Y lo que NO da este permiso: instalar en silencio. Android ensena su
         pantalla de «¿instalar?» y ahi confirma la persona, siempre. Eso se dice en
         la interfaz antes de empezar, para que no se lea como un error. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <application
        android:label="Reparto"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- EL FICHERO SE LE PASA AL INSTALADOR POR AQUI.

             Desde Android 7 no se puede entregar un `file://` a otra aplicacion
             (`FileUriExposedException`), asi que el APK bajado viaja como un
             `content://` de este proveedor, con permiso de lectura para una sola
             peticion. Que carpetas puede ofrecer esta en
             `res/xml/ficheros_de_la_actualizacion.xml`: las de esta aplicacion y
             ninguna otra.

             `exported="false"`: nadie lo llama de fuera. Lo unico que lo abre es el
             instalador, y lo abre porque se le da permiso en el propio Intent
             (`FLAG_GRANT_READ_URI_PERMISSION`).

             La clase es NUESTRA (`FicherosDelReparto`) y no
             `androidx.core.content.FileProvider` a secas: en este APK ya hay dos
             proveedores que son FileProvider —el de `share_plus` y el de
             `printing`— y Android exige una clase distinta por cada `<provider>`. -->
        <provider
            android:name=".FicherosDelReparto"
            android:authorities="${applicationId}.ficheros"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ficheros_de_la_actualizacion"/>
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
